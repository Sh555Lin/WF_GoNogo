   "source": [
    "#!/usr/bin/env python3\n",
    "# -*- coding: utf-8 -*-\n",
    "\"\"\"\n",
    "批量双侧STA分析 - 支持按trial type分类\n",
    "\n",
    "主要功能:\n",
    "1. 计算左右脑特定区域的STA (Stimulus-Triggered Average)\n",
    "2. 按trial type (HIT/MISS/FA/CR) 分类分析\n",
    "3. 计算左右脑差异 (Left - Right)\n",
    "4. 批量处理多个session和多个脑区\n",
    "5. 生成丰富的可视化结果\n",
    "\n",
    "使用方法:\n",
    "    results = batch_analyze_bilateral_STA_by_trial_type(\n",
    "        animal='A095',\n",
    "        region_acronyms=['VISp', 'VISl'],\n",
    "        wf_framerate=10,\n",
    "        pre_stim=0.5,\n",
    "        post_stim=3.0,\n",
    "        visualize=True\n",
    "    )\n",
    "\"\"\"\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import json\n",
    "import os\n",
    "import yaml\n",
    "from time import time\n",
    "from pathlib import Path\n",
    "\n",
    "\n",
    "# ============================================================================\n",
    "# 核心计算函数\n",
    "# ============================================================================\n",
    "\n",
    "def compute_region_weights_from_U(U_neuro, region_mask):\n",
    "    \"\"\"\n",
    "    计算mask区域在U空间的权重\n",
    "    \n",
    "    Parameters\n",
    "    ----------\n",
    "    U_neuro : ndarray, shape (H, W, n_components)\n",
    "        SVD的U矩阵\n",
    "    region_mask : ndarray, shape (H, W)\n",
    "        区域mask (boolean)\n",
    "        \n",
    "    Returns\n",
    "    -------\n",
    "    U_weights : ndarray, shape (n_components,)\n",
    "        该区域的U权重向量\n",
    "    \"\"\"\n",
    "    if region_mask.sum() == 0:\n",
    "        print(\"   Warning: Empty mask!\")\n",
    "        return np.zeros(U_neuro.shape[2])\n",
    "    \n",
    "    U_masked = U_neuro[region_mask]  # (n_pixels, n_components)\n",
    "    U_weights = U_masked.mean(axis=0)  # (n_components,)\n",
    "    \n",
    "    return U_weights\n",
    "\n",
    "\n",
    "def compute_STA_fast_with_trial_type(stim_timestamps, trial_timestamps, trial_type,\n",
    "                                     U_weights, V_neuro_hemocorr, hemocorr_t, \n",
    "                                     pre_stim=0.5, post_stim=3.0, wf_framerate=10):\n",
    "    \"\"\"\n",
    "    按trial type计算STA\n",
    "    \n",
    "    Parameters\n",
    "    ----------\n",
    "    stim_timestamps : ndarray\n",
    "        刺激时间戳（相对于trial开始的时间）\n",
    "    trial_timestamps : ndarray\n",
    "        Trial开始时间戳\n",
    "    trial_type : ndarray\n",
    "        Trial类型 (1=HIT, 2=MISS, 3=FA, 4=CR)\n",
    "    U_weights : ndarray\n",
    "        区域的U权重\n",
    "    V_neuro_hemocorr : ndarray\n",
    "        V矩阵 (n_components, n_frames)\n",
    "    hemocorr_t : ndarray\n",
    "        时间轴\n",
    "        \n",
    "    Returns\n",
    "    -------\n",
    "    sta_dict : dict\n",
    "        {1: {'sta': ..., 'count': ..., 'name': 'HIT'}, ...}\n",
    "    t_window : ndarray\n",
    "        时间窗口\n",
    "    \"\"\"\n",
    "    \n",
    "    n_pre = int(pre_stim * wf_framerate)\n",
    "    n_post = int(post_stim * wf_framerate)\n",
    "    n_window = n_pre + n_post + 1\n",
    "    t_window = np.linspace(-pre_stim, post_stim, n_window)\n",
    "    \n",
    "    n_frames = V_neuro_hemocorr.shape[1]\n",
    "    \n",
    "    # 计算绝对时间的刺激时间戳\n",
    "    stim_onsets = np.array([stim[0] for stim in stim_timestamps]) + \\\n",
    "                  np.array([trial[0] for trial in trial_timestamps])\n",
    "    \n",
    "    # 按trial type分类\n",
    "    trial_type_names = {1: 'HIT', 2: 'MISS', 3: 'FA', 4: 'CR'}\n",
    "    sta_dict = {}\n",
    "    \n",
    "    for tt in [1, 2, 3, 4]:\n",
    "        # 获取该类型的trials\n",
    "        tt_indices = np.where(trial_type == tt)[0]\n",
    "        tt_stim_onsets = stim_onsets[tt_indices]\n",
    "        \n",
    "        if len(tt_stim_onsets) == 0:\n",
    "            sta_dict[tt] = {\n",
    "                'sta': np.zeros(n_window),\n",
    "                'count': 0,\n",
    "                'name': trial_type_names[tt]\n",
    "            }\n",
    "            continue\n",
    "        \n",
    "        # 收集V片段\n",
    "        V_snippets = []\n",
    "        \n",
    "        for stim_t in tt_stim_onsets:\n",
    "            idx = np.argmin(np.abs(hemocorr_t - stim_t))\n",
    "            \n",
    "            if idx - n_pre < 0 or idx + n_post >= n_frames:\n",
    "                continue\n",
    "            \n",
    "            V_snippet = V_neuro_hemocorr[:, idx - n_pre : idx + n_post + 1]\n",
    "            V_snippets.append(V_snippet)\n",
    "        \n",
    "        if len(V_snippets) == 0:\n",
    "            sta_dict[tt] = {\n",
    "                'sta': np.zeros(n_window),\n",
    "                'count': 0,\n",
    "                'name': trial_type_names[tt]\n",
    "            }\n",
    "            continue\n",
    "        \n",
    "        # 矩阵化计算\n",
    "        V_snippets = np.array(V_snippets)  # (n_trials, n_comp, n_window)\n",
    "        region_activity = np.einsum('c,nct->nt', U_weights, V_snippets)\n",
    "        sta_trace = region_activity.mean(axis=0)\n",
    "        \n",
    "        sta_dict[tt] = {\n",
    "            'sta': sta_trace,\n",
    "            'count': len(V_snippets),\n",
    "            'name': trial_type_names[tt]\n",
    "        }\n",
    "    \n",
    "    return sta_dict, t_window\n",
    "\n",
    "\n",
    "def compute_bilateral_STA_by_trial_type(stim_timestamps, trial_timestamps, trial_type,\n",
    "                                       U_neuro, V_neuro_hemocorr, hemocorr_t,\n",
    "                                       left_mask, right_mask,\n",
    "                                       pre_stim=0.5, post_stim=3.0, wf_framerate=10):\n",
    "    \"\"\"\n",
    "    计算按trial type分类的双侧STA\n",
    "    \n",
    "    Returns\n",
    "    -------\n",
    "    results : dict\n",
    "        {\n",
    "            'HIT': {'left_sta': ..., 'right_sta': ..., 'diff_sta': ..., 'count': ...},\n",
    "            'MISS': {...},\n",
    "            'FA': {...},\n",
    "            'CR': {...},\n",
    "            't_window': ...,\n",
    "            'left_U_weights': ...,\n",
    "            'right_U_weights': ...\n",
    "        }\n",
    "    \"\"\"\n",
    "    \n",
    "    # 1. 计算U权重\n",
    "    left_U_weights = compute_region_weights_from_U(U_neuro, left_mask)\n",
    "    right_U_weights = compute_region_weights_from_U(U_neuro, right_mask)\n",
    "    \n",
    "    # 2. 计算左脑STA（按trial type）\n",
    "    left_sta_dict, t_window = compute_STA_fast_with_trial_type(\n",
    "        stim_timestamps, trial_timestamps, trial_type,\n",
    "        left_U_weights, V_neuro_hemocorr, hemocorr_t,\n",
    "        pre_stim, post_stim, wf_framerate\n",
    "    )\n",
    "    \n",
    "    # 3. 计算右脑STA（按trial type）\n",
    "    right_sta_dict, _ = compute_STA_fast_with_trial_type(\n",
    "        stim_timestamps, trial_timestamps, trial_type,\n",
    "        right_U_weights, V_neuro_hemocorr, hemocorr_t,\n",
    "        pre_stim, post_stim, wf_framerate\n",
    "    )\n",
    "    \n",
    "    # 4. 整理结果\n",
    "    results = {\n",
    "        't_window': t_window,\n",
    "        'left_U_weights': left_U_weights,\n",
    "        'right_U_weights': right_U_weights\n",
    "    }\n",
    "    \n",
    "    trial_type_names = {1: 'HIT', 2: 'MISS', 3: 'FA', 4: 'CR'}\n",
    "    \n",
    "    for tt in [1, 2, 3, 4]:\n",
    "        name = trial_type_names[tt]\n",
    "        results[name] = {\n",
    "            'left_sta': left_sta_dict[tt]['sta'],\n",
    "            'right_sta': right_sta_dict[tt]['sta'],\n",
    "            'diff_sta': left_sta_dict[tt]['sta'] - right_sta_dict[tt]['sta'],\n",
    "            'count': left_sta_dict[tt]['count']\n",
    "        }\n",
    "    \n",
    "    return results\n",
    "\n",
    "\n",
    "# ============================================================================  \n",
    "# CCF Mask创建函数\n",
    "# ============================================================================\n",
    "\n",
    "def create_bilateral_masks_from_ccf(ccf_json_path, region_acronym, image_shape):\n",
    "    \"\"\"\n",
    "    根据CCF JSON格式创建左右脑mask\n",
    "    \"\"\"\n",
    "    \n",
    "    with open(ccf_json_path, 'r') as f:\n",
    "        ccf_data = json.load(f)\n",
    "    \n",
    "    ccf_regions = ccf_data['ccf_regions']\n",
    "    \n",
    "    H, W = image_shape\n",
    "    left_mask = np.zeros((H, W), dtype=bool)\n",
    "    right_mask = np.zeros((H, W), dtype=bool)\n",
    "    \n",
    "    print(f\"   Searching for region: {region_acronym}\")\n",
    "    \n",
    "    found = False\n",
    "    for region_data in ccf_regions:\n",
    "        if region_data.get('acronym') == region_acronym:\n",
    "            found = True\n",
    "            \n",
    "            left_x = region_data.get('left_x', [])\n",
    "            left_y = region_data.get('left_y', [])\n",
    "            right_x = region_data.get('right_x', [])\n",
    "            right_y = region_data.get('right_y', [])\n",
    "            \n",
    "            print(f\"   Found {region_acronym}:\")\n",
    "            print(f\"     Left points: {len(left_x)}\")\n",
    "            print(f\"     Right points: {len(right_x)}\")\n",
    "            \n",
    "            # 创建左脑mask\n",
    "            if len(left_x) > 0 and len(left_y) > 0:\n",
    "                from matplotlib.path import Path as MplPath\n",
    "                \n",
    "                contour_left = np.column_stack([left_x, left_y])\n",
    "                \n",
    "                x_coords = np.arange(W)\n",
    "                y_coords = np.arange(H)\n",
    "                x_grid, y_grid = np.meshgrid(x_coords, y_coords)\n",
    "                points = np.vstack([x_grid.ravel(), y_grid.ravel()]).T\n",
    "                \n",
    "                path = MplPath(contour_left)\n",
    "                mask_flat = path.contains_points(points)\n",
    "                left_mask = mask_flat.reshape((H, W))\n",
    "                \n",
    "                print(f\"     Left mask: {left_mask.sum()} pixels\")\n",
    "            \n",
    "            # 创建右脑mask\n",
    "            if len(right_x) > 0 and len(right_y) > 0:\n",
    "                from matplotlib.path import Path as MplPath\n",
    "                \n",
    "                contour_right = np.column_stack([right_x, right_y])\n",
    "                \n",
    "                x_coords = np.arange(W)\n",
    "                y_coords = np.arange(H)\n",
    "                x_grid, y_grid = np.meshgrid(x_coords, y_coords)\n",
    "                points = np.vstack([x_grid.ravel(), y_grid.ravel()]).T\n",
    "                \n",
    "                path = MplPath(contour_right)\n",
    "                mask_flat = path.contains_points(points)\n",
    "                right_mask = mask_flat.reshape((H, W))\n",
    "                \n",
    "                print(f\"     Right mask: {right_mask.sum()} pixels\")\n",
    "            \n",
    "            break\n",
    "    \n",
    "    if not found:\n",
    "        print(f\"   Region '{region_acronym}' not found!\")\n",
    "        raise ValueError(f\"Region '{region_acronym}' not found in CCF data\")\n",
    "    \n",
    "    return left_mask, right_mask\n",
    "\n",
    "\n",
    "# ============================================================================\n",
    "# 可视化函数\n",
    "# ============================================================================\n",
    "\n",
    "def plot_bilateral_STA_by_trial_type(results, region_name, target_date, \n",
    "                                    save_path=None):\n",
    "    \"\"\"\n",
    "    绘制4种trial type的双侧STA对比图\n",
    "    每个trial type一行，包含：左脑、右脑、左右叠加、差值\n",
    "    前3列使用统一的Y轴scale\n",
    "    \"\"\"\n",
    "    \n",
    "    t_window = results['t_window']\n",
    "    trial_types = ['HIT', 'MISS', 'FA', 'CR']\n",
    "    colors = {\n",
    "        'HIT': 'green',\n",
    "        'MISS': 'orange', \n",
    "        'FA': 'red',\n",
    "        'CR': 'blue'\n",
    "    }\n",
    "    \n",
    "    # 创建4行4列的图\n",
    "    fig, axes = plt.subplots(4, 4, figsize=(24, 16))\n",
    "    \n",
    "    # 计算全局Y轴范围\n",
    "    all_left_vals = []\n",
    "    all_right_vals = []\n",
    "    all_diff_vals = []\n",
    "    \n",
    "    for tt in trial_types:\n",
    "        data = results[tt]\n",
    "        if data['count'] > 0:\n",
    "            all_left_vals.extend(data['left_sta'])\n",
    "            all_right_vals.extend(data['right_sta'])\n",
    "            all_diff_vals.extend(data['diff_sta'])\n",
    "    \n",
    "    # 左脑和右脑使用统一的Y轴范围\n",
    "    lr_min = min(min(all_left_vals), min(all_right_vals))\n",
    "    lr_max = max(max(all_left_vals), max(all_right_vals))\n",
    "    lr_margin = (lr_max - lr_min) * 0.1\n",
    "    lr_ylim = [lr_min - lr_margin, lr_max + lr_margin]\n",
    "    \n",
    "    # 差值使用独立的Y轴范围\n",
    "    diff_min = min(all_diff_vals)\n",
    "    diff_max = max(all_diff_vals)\n",
    "    diff_margin = (diff_max - diff_min) * 0.1\n",
    "    diff_ylim = [diff_min - diff_margin, diff_max + diff_margin]\n",
    "    \n",
    "    # 绘制每个trial type\n",
    "    for i, tt in enumerate(trial_types):\n",
    "        data = results[tt]\n",
    "        left_sta = data['left_sta']\n",
    "        right_sta = data['right_sta']\n",
    "        diff_sta = data['diff_sta']\n",
    "        count = data['count']\n",
    "        \n",
    "        color = colors[tt]\n",
    "        \n",
    "        # 第1列：左脑\n",
    "        ax = axes[i, 0]\n",
    "        ax.plot(t_window, left_sta, color=color, lw=2.5, label=f'{tt} (n={count})')\n",
    "        ax.axvline(0, color='k', linestyle='--', lw=1.5, alpha=0.5)\n",
    "        ax.axhline(0, color='k', linestyle='-', lw=0.5, alpha=0.5)\n",
    "        ax.set_ylim(lr_ylim)  # 统一Y轴\n",
    "        ax.set_ylabel('Activity (dF/F)', fontsize=11)\n",
    "        if i == 0:\n",
    "            ax.set_title(f'Left {region_name}', fontsize=13, fontweight='bold', color='red')\n",
    "        ax.legend(fontsize=10, loc='upper right')\n",
    "        ax.grid(True, alpha=0.3)\n",
    "        if i < 3:\n",
    "            ax.set_xticklabels([])\n",
    "        else:\n",
    "            ax.set_xlabel('Time (s)', fontsize=11)\n",
    "        \n",
    "        # 第2列：右脑\n",
    "        ax = axes[i, 1]\n",
    "        ax.plot(t_window, right_sta, color=color, lw=2.5, label=f'{tt} (n={count})')\n",
    "        ax.axvline(0, color='k', linestyle='--', lw=1.5, alpha=0.5)\n",
    "        ax.axhline(0, color='k', linestyle='-', lw=0.5, alpha=0.5)\n",
    "        ax.set_ylim(lr_ylim)  # 统一Y轴\n",
    "        if i == 0:\n",
    "            ax.set_title(f'Right {region_name}', fontsize=13, fontweight='bold', color='blue')\n",
    "        ax.legend(fontsize=10, loc='upper right')\n",
    "        ax.grid(True, alpha=0.3)\n",
    "        if i < 3:\n",
    "            ax.set_xticklabels([])\n",
    "        else:\n",
    "            ax.set_xlabel('Time (s)', fontsize=11)\n",
    "        \n",
    "        # 第3列：左右叠加（新增）\n",
    "        ax = axes[i, 2]\n",
    "        ax.plot(t_window, left_sta, 'r-', lw=2.5, label='Left', alpha=0.8)\n",
    "        ax.plot(t_window, right_sta, 'b-', lw=2.5, label='Right', alpha=0.8)\n",
    "        ax.axvline(0, color='k', linestyle='--', lw=1.5, alpha=0.5)\n",
    "        ax.axhline(0, color='k', linestyle='-', lw=0.5, alpha=0.5)\n",
    "        ax.set_ylim(lr_ylim)  # 统一Y轴\n",
    "        if i == 0:\n",
    "            ax.set_title('Left + Right Overlay', fontsize=13, fontweight='bold', color='purple')\n",
    "        ax.legend(fontsize=10, loc='upper right')\n",
    "        ax.grid(True, alpha=0.3)\n",
    "        # 添加trial type标签\n",
    "        ax.text(0.02, 0.98, f'{tt} (n={count})', transform=ax.transAxes,\n",
    "               fontsize=10, verticalalignment='top', \n",
    "               bbox=dict(boxstyle='round', facecolor=color, alpha=0.3))\n",
    "        if i < 3:\n",
    "            ax.set_xticklabels([])\n",
    "        else:\n",
    "            ax.set_xlabel('Time (s)', fontsize=11)\n",
    "        \n",
    "        # 第4列：差值\n",
    "        ax = axes[i, 3]\n",
    "        ax.plot(t_window, diff_sta, color=color, lw=2.5, label=f'{tt} (n={count})')\n",
    "        ax.axvline(0, color='k', linestyle='--', lw=1.5, alpha=0.5)\n",
    "        ax.axhline(0, color='k', linestyle='-', lw=0.5, alpha=0.5)\n",
    "        ax.fill_between(t_window, 0, diff_sta, where=(diff_sta >= 0),\n",
    "                        color='red', alpha=0.2)\n",
    "        ax.fill_between(t_window, 0, diff_sta, where=(diff_sta < 0),\n",
    "                        color='blue', alpha=0.2)\n",
    "        ax.set_ylim(diff_ylim)  # 差值用独立的scale\n",
    "        if i == 0:\n",
    "            ax.set_title('Left - Right', fontsize=13, fontweight='bold', color='purple')\n",
    "        ax.legend(fontsize=10, loc='upper right')\n",
    "        ax.grid(True, alpha=0.3)\n",
    "        if i < 3:\n",
    "            ax.set_xticklabels([])\n",
    "        else:\n",
    "            ax.set_xlabel('Time (s)', fontsize=11)\n",
    "    \n",
    "    plt.suptitle(f'{region_name} - Bilateral STA by Trial Type - {target_date}',\n",
    "                fontsize=16, fontweight='bold', y=0.995)\n",
    "    plt.tight_layout()\n",
    "    \n",
    "    if save_path:\n",
    "        os.makedirs(os.path.dirname(save_path), exist_ok=True)\n",
    "        plt.savefig(save_path, dpi=150, bbox_inches='tight')\n",
    "        print(f\"   Saved: {save_path}\")\n",
    "    \n",
    "    plt.show()\n",
    "    plt.close()\n",
    "\n",
    "\n",
    "def plot_bilateral_STA_overlay_by_trial_type(results, region_name, target_date,\n",
    "                                             save_path=None):\n",
    "    \"\"\"\n",
    "    将4种trial type叠加在一张图上显示\n",
