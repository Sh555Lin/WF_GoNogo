   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from os.path import join as pjoin\n",
    "from scipy import stats\n",
    "\n",
    "def compute_ICA_trial_average(S, hemocorr_t, trial_timestamps, trial_type, \n",
    "                               pre_trial=0.5, post_trial=3.0):\n",
    "    \"\"\"\n",
    "    计算每个trial type的ICA成分平均响应\n",
    "    \n",
    "    Parameters:\n",
    "    -----------\n",
    "    S : ndarray, shape (n_timepoints, n_components)\n",
    "        ICA时间序列\n",
    "    hemocorr_t : ndarray\n",
    "        时间戳\n",
    "    trial_timestamps : ndarray, shape (n_trials, 2)\n",
    "        每个trial的[start, end]时间\n",
    "    trial_type : ndarray, shape (n_trials,)\n",
    "        每个trial的类型 (1=HIT, 2=MISS, 3=FA, 4=CR)\n",
    "    pre_trial : float\n",
    "        trial开始前的时间窗口(秒)\n",
    "    post_trial : float\n",
    "        trial开始后的时间窗口(秒)\n",
    "    \n",
    "    Returns:\n",
    "    --------\n",
    "    ica_sta_dict : dict\n",
    "        每个trial type的平均ICA响应\n",
    "    t_window : ndarray\n",
    "        时间窗口\n",
    "    \"\"\"\n",
    "    n_components = S.shape[1]\n",
    "    trial_type_names = {1: 'HIT', 2: 'MISS', 3: 'FA', 4: 'CR'}\n",
    "    \n",
    "    # 估计采样率\n",
    "    dt = np.median(np.diff(hemocorr_t))\n",
    "    \n",
    "    # 创建时间窗口\n",
    "    n_pre = int(pre_trial / dt)\n",
    "    n_post = int(post_trial / dt)\n",
    "    n_window = n_pre + n_post\n",
    "    t_window = np.linspace(-pre_trial, post_trial, n_window)\n",
    "    \n",
    "    ica_sta_dict = {}\n",
    "    \n",
    "    # 确保trial_type是numpy数组\n",
    "    trial_type = np.asarray(trial_type)\n",
    "    \n",
    "    for tt in [1, 2, 3, 4]:\n",
    "        # 找到该类型的所有trials\n",
    "        trial_indices = np.where(trial_type == tt)[0]\n",
    "        n_trials = len(trial_indices)\n",
    "        \n",
    "        if n_trials == 0:\n",
    "            print(f\"Warning: No trials found for {trial_type_names[tt]}\")\n",
    "            continue\n",
    "        \n",
    "        # 初始化存储\n",
    "        trial_responses = np.zeros((n_trials, n_window, n_components))\n",
    "        valid_trials = []\n",
    "        \n",
    "        # 对每个trial提取ICA响应\n",
    "        for i, trial_idx in enumerate(trial_indices):\n",
    "            trial_start = trial_timestamps[trial_idx, 0]\n",
    "            \n",
    "            # 找到trial开始时刻在时间序列中的索引\n",
    "            start_idx = np.argmin(np.abs(hemocorr_t - (trial_start - pre_trial)))\n",
    "            end_idx = start_idx + n_window\n",
    "            \n",
    "            # 检查是否超出边界\n",
    "            if start_idx >= 0 and end_idx <= len(hemocorr_t):\n",
    "                trial_responses[i, :, :] = S[start_idx:end_idx, :]\n",
    "                valid_trials.append(i)\n",
    "        \n",
    "        # 只保留有效的trials\n",
    "        trial_responses = trial_responses[valid_trials, :, :]\n",
    "        n_valid = len(valid_trials)\n",
    "        \n",
    "        # 计算平均和标准误\n",
    "        mean_response = np.mean(trial_responses, axis=0)  # (n_window, n_components)\n",
    "        sem_response = stats.sem(trial_responses, axis=0)  # (n_window, n_components)\n",
    "        \n",
    "        ica_sta_dict[tt] = {\n",
    "            'name': trial_type_names[tt],\n",
    "            'mean': mean_response,\n",
    "            'sem': sem_response,\n",
    "            'trials': trial_responses,\n",
    "            'count': n_valid\n",
    "        }\n",
    "        \n",
    "        print(f\"{trial_type_names[tt]}: {n_valid} trials\")\n",
    "    \n",
    "    return ica_sta_dict, t_window\n",
    "\n",
    "\n",
    "def plot_ICA_by_trial_type(ica_sta_dict, t_window, n_components=20):\n",
    "    \"\"\"\n",
    "    绘制每个ICA成分在不同trial type下的响应\n",
    "    \"\"\"\n",
    "    trial_type_names = {1: 'HIT', 2: 'MISS', 3: 'FA', 4: 'CR'}\n",
    "    colors = {1: '#2ecc71', 2: '#e74c3c', 3: '#f39c12', 4: '#3498db'}\n",
    "    \n",
    "    # 为每个ICA成分创建一个子图\n",
    "    n_cols = 4\n",
    "    n_rows = int(np.ceil(n_components / n_cols))\n",
    "    \n",
    "    fig, axes = plt.subplots(n_rows, n_cols, figsize=(20, 5*n_rows))\n",
    "    axes = axes.flatten()\n",
    "    \n",
    "    for ic in range(n_components):\n",
    "        ax = axes[ic]\n",
    "        \n",
    "        # 绘制每个trial type\n",
    "        for tt in [1, 2, 3, 4]:\n",
    "            if tt not in ica_sta_dict:\n",
    "                continue\n",
    "            \n",
    "            data = ica_sta_dict[tt]\n",
    "            mean_trace = data['mean'][:, ic]\n",
    "            sem_trace = data['sem'][:, ic]\n",
    "            \n",
    "            # 绘制平均值\n",
    "            ax.plot(t_window, mean_trace, color=colors[tt], \n",
    "                   label=f\"{data['name']} (n={data['count']})\", linewidth=2)\n",
    "            \n",
    "            # 绘制标准误\n",
    "            ax.fill_between(t_window, \n",
    "                           mean_trace - sem_trace,\n",
    "                           mean_trace + sem_trace,\n",
    "                           color=colors[tt], alpha=0.2)\n",
    "        \n",
    "        # 添加刺激开始线\n",
    "        ax.axvline(x=0, color='black', linestyle='--', linewidth=1, alpha=0.5)\n",
    "        ax.axhline(y=0, color='gray', linestyle='-', linewidth=0.5, alpha=0.3)\n",
    "        \n",
    "        ax.set_title(f'IC {ic+1}', fontsize=12, fontweight='bold')\n",
    "        ax.set_xlabel('Time from trial start (s)', fontsize=10)\n",
    "        ax.set_ylabel('ICA Activity', fontsize=10)\n",
    "        ax.legend(fontsize=8, loc='upper right')\n",
    "        ax.grid(True, alpha=0.3)\n",
    "        ax.spines['top'].set_visible(False)\n",
    "        ax.spines['right'].set_visible(False)\n",
    "    \n",
    "    # 隐藏多余的子图\n",
    "    for ic in range(n_components, len(axes)):\n",
    "        axes[ic].axis('off')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    return fig\n",
    "\n",
    "\n",
    "def plot_ICA_heatmap_by_trial_type(ica_sta_dict, t_window, n_components=20):\n",
    "    \"\"\"\n",
    "    用热图显示所有ICA成分在不同trial type下的响应\n",
    "    \"\"\"\n",
    "    trial_types = [1, 2, 3, 4]\n",
    "    trial_type_names = {1: 'HIT', 2: 'MISS', 3: 'FA', 4: 'CR'}\n",
    "    \n",
    "    fig, axes = plt.subplots(2, 2, figsize=(20, 16))\n",
    "    axes = axes.flatten()\n",
    "    \n",
    "    for idx, tt in enumerate(trial_types):\n",
    "        if tt not in ica_sta_dict:\n",
    "            continue\n",
    "        \n",
    "        ax = axes[idx]\n",
    "        data = ica_sta_dict[tt]['mean']  # (n_window, n_components)\n",
    "        \n",
    "        # 转置使ICA成分在y轴\n",
    "        data_to_plot = data[:, :n_components].T\n",
    "        \n",
    "        # 归一化每个成分\n",
    "        vmax = np.percentile(np.abs(data_to_plot), 95)\n",
    "        \n",
    "        im = ax.imshow(data_to_plot, aspect='auto', cmap='RdBu_r',\n",
    "                      vmin=-vmax, vmax=vmax,\n",
    "                      extent=[t_window[0], t_window[-1], n_components, 1])\n",
    "        \n",
    "        ax.axvline(x=0, color='black', linestyle='--', linewidth=2)\n",
    "        ax.set_xlabel('Time from trial start (s)', fontsize=12, fontweight='bold')\n",
    "        ax.set_ylabel('ICA Component', fontsize=12, fontweight='bold')\n",
    "        ax.set_title(f\"{trial_type_names[tt]} (n={ica_sta_dict[tt]['count']})\", \n",
    "                    fontsize=14, fontweight='bold')\n",
    "        \n",
    "        plt.colorbar(im, ax=ax, label='ICA Activity')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    return fig\n",
    "\n",
    "\n",
    "def compute_trial_type_differences(ica_sta_dict, t_window):\n",
    "    \"\"\"\n",
    "    计算不同trial type之间的统计差异\n",
    "    \"\"\"\n",
    "    print(\"\\n=== Statistical Comparison Between Trial Types ===\")\n",
    "    \n",
    "    n_components = ica_sta_dict[1]['mean'].shape[1]\n",
    "    comparisons = [\n",
    "        (1, 2, 'HIT vs MISS'),\n",
    "        (1, 4, 'HIT vs CR'),\n",
    "        (3, 4, 'FA vs CR'),\n",
    "    ]\n",
    "    \n",
    "    for tt1, tt2, name in comparisons:\n",
    "        if tt1 not in ica_sta_dict or tt2 not in ica_sta_dict:\n",
    "            continue\n",
    "        \n",
    "        print(f\"\\n{name}:\")\n",
    "        \n",
    "        trials1 = ica_sta_dict[tt1]['trials']  # (n_trials1, n_window, n_components)\n",
    "        trials2 = ica_sta_dict[tt2]['trials']\n",
    "        \n",
    "        # 对每个ICA成分进行t检验\n",
    "        significant_components = []\n",
    "        \n",
    "        for ic in range(n_components):\n",
    "            # 取平均活动（整个时间窗口）\n",
    "            mean_activity1 = np.mean(trials1[:, :, ic], axis=1)\n",
    "            mean_activity2 = np.mean(trials2[:, :, ic], axis=1)\n",
    "            \n",
    "            # t检验\n",
    "            t_stat, p_value = stats.ttest_ind(mean_activity1, mean_activity2)\n",
    "            \n",
    "            if p_value < 0.05:\n",
    "                significant_components.append((ic+1, p_value, t_stat))\n",
    "        \n",
    "        if significant_components:\n",
    "            print(f\"  Significant components (p < 0.05): {len(significant_components)}/{n_components}\")\n",
    "            for ic, pval, tstat in significant_components[:5]:  # 显示前5个\n",
    "                print(f\"    IC {ic}: p={pval:.4f}, t={tstat:.3f}\")\n",
    "        else:\n",
    "            print(f\"  No significant differences found\")\n",
    "\n",
    "\n",
    "# ====== 主分析流程 ======\n",
    "\n",
    "# 加载ICA结果\n",
    "processPath = config[\"paths\"][\"process\"].format(\n",
    "    base_dir=config[\"base_dir\"], mouse_id=config[\"mouse_id\"], session=session\n",
    ")\n",
    "timePath = config[\"paths\"][\"time\"].format(\n",
    "    base_dir=config[\"base_dir\"], mouse_id=config[\"mouse_id\"], session=session\n",
    ")\n",
    "rawPath = config[\"paths\"][\"raw\"].format(\n",
    "    base_dir=config[\"base_dir\"], mouse_id=config[\"mouse_id\"], session=session\n",
    ")\n",
    "\n",
    "S = np.load(pjoin(processPath, \"ICA_sources.npy\"))\n",
    "hemocorr_t = np.load(pjoin(timePath, \"hemocorr_t.npy\"))\n",
    "trial_timestamps = np.load(pjoin(timePath, \"trial_timestamp.npy\"))\n",
    "trial_type = load_trial_type(rawPath, timePath)\n",
    "\n",
    "# 确保trial_type是numpy数组\n",
    "trial_type = np.array(trial_type)\n",
    "\n",
    "print(f\"ICA sources shape: {S.shape}\")\n",
    "print(f\"trial_type shape: {trial_type.shape}\")\n",
    "print(f\"trial_type dtype: {trial_type.dtype}\")\n",
    "print(f\"Number of trials: {len(trial_type)}\")\n",
    "print(f\"Trial timestamps shape: {trial_timestamps.shape}\")\n",
    "print(f\"Unique trial types: {np.unique(trial_type)}\")\n",
    "\n",
    "# 计算每个trial type的ICA响应\n",
    "print(\"\\nComputing ICA trial-averaged responses...\")\n",
    "ica_sta_dict, t_window = compute_ICA_trial_average(\n",
    "    S, hemocorr_t, trial_timestamps, trial_type,\n",
    "    pre_trial=0.5, post_trial=3.0\n",
    ")\n",
    "\n",
    "# 绘图1: 每个ICA成分的线图\n",
    "print(\"\\nPlotting ICA traces by trial type...\")\n",
    "fig1 = plot_ICA_by_trial_type(ica_sta_dict, t_window, n_components=20)\n",
    "plt.savefig(pjoin(processPath, 'ICA_trial_type_traces.png'), dpi=300, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "# 绘图2: 热图\n",
    "print(\"\\nPlotting ICA heatmaps by trial type...\")\n",
    "fig2 = plot_ICA_heatmap_by_trial_type(ica_sta_dict, t_window, n_components=20)\n",
    "plt.savefig(pjoin(processPath, 'ICA_trial_type_heatmaps.png'), dpi=300, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "# 统计分析\n",
    "compute_trial_type_differences(ica_sta_dict, t_window)\n",
    "\n",
    "print(f\"\\n所有结果已保存到: {processPath}\")"
   ]
  }
