_framerate\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m    488\u001b[39m \u001b[43m    \u001b[49m\u001b[43mpre_stim\u001b[49m\u001b[43m=\u001b[49m\u001b[43mpre_stim\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m    489\u001b[39m \u001b[43m    \u001b[49m\u001b[43mpost_stim\u001b[49m\u001b[43m=\u001b[49m\u001b[43mpost_stim\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m    490\u001b[39m \u001b[43m    \u001b[49m\u001b[43msave_dir\u001b[49m\u001b[43m=\u001b[49m\u001b[43msave_dir\u001b[49m\n\u001b[32m    491\u001b[39m \u001b[43m\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    493\u001b[39m \u001b[38;5;66;03m# ========== 结果 ==========\u001b[39;00m\n\u001b[32m    494\u001b[39m \n\u001b[32m    495\u001b[39m \u001b[38;5;66;03m# if results is not None:\u001b[39;00m\n\u001b[32m   (...)\u001b[39m\u001b[32m    504\u001b[39m \u001b[38;5;66;03m#     print(f\"  Max diff at: {t_max:.3f}s\")\u001b[39;00m\n\u001b[32m    505\u001b[39m \u001b[38;5;66;03m#     print(f\"  Min diff at: {t_min:.3f}s\")\u001b[39;00m\n",
      "\u001b[36mCell\u001b[39m\u001b[36m \u001b[39m\u001b[32mIn[14]\u001b[39m\u001b[32m, line 370\u001b[39m, in \u001b[36manalyze_bilateral_STA\u001b[39m\u001b[34m(ccf_json_path, U_neuro, V_neuro_hemocorr, hemocorr_t, stim_timestamps, image_shape, region_acronym, wf_framerate, pre_stim, post_stim, save_dir)\u001b[39m\n\u001b[32m    368\u001b[39m \u001b[38;5;28mprint\u001b[39m(\u001b[33mf\u001b[39m\u001b[33m\"\u001b[39m\u001b[38;5;130;01m\\n\u001b[39;00m\u001b[33m Step 1: Creating \u001b[39m\u001b[38;5;132;01m{\u001b[39;00mregion_acronym\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m masks...\u001b[39m\u001b[33m\"\u001b[39m)\n\u001b[32m    369\u001b[39m t0 = time()\n\u001b[32m--> \u001b[39m\u001b[32m370\u001b[39m left_mask, right_mask = \u001b[43mcreate_bilateral_masks_from_your_format\u001b[49m\u001b[43m(\u001b[49m\n\u001b[32m    371\u001b[39m \u001b[43m    \u001b[49m\u001b[43mccf_json_path\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mregion_acronym\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mimage_shape\u001b[49m\n\u001b[32m    372\u001b[39m \u001b[43m\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    373\u001b[39m \u001b[38;5;28mprint\u001b[39m(\u001b[33mf\u001b[39m\u001b[33m\"\u001b[39m\u001b[33m   Time: \u001b[39m\u001b[38;5;132;01m{\u001b[39;00mtime()-t0\u001b[38;5;132;01m:\u001b[39;00m\u001b[33m.3f\u001b[39m\u001b[38;5;132;01m}\u001b[39;00m\u001b[33ms\u001b[39m\u001b[33m\"\u001b[39m)\n\u001b[32m    375\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m left_mask.sum() == \u001b[32m0\u001b[39m \u001b[38;5;129;01mor\u001b[39;00m right_mask.sum() == \u001b[32m0\u001b[39m:\n",
