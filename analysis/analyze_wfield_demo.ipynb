    "    ax = axes[1]\n",
    "    for tt in trial_types:\n",
    "        data = results[tt]\n",
    "        if data['count'] > 0:\n",
    "            ax.plot(t_window, data['right_sta'], color=colors[tt],\n",
    "                   lw=2.5, label=f\"{tt} (n={data['count']})\", alpha=0.8)\n",
    "    ax.axvline(0, color='k', linestyle='--', lw=2, alpha=0.7)\n",
    "    ax.axhline(0, color='k', linestyle='-', lw=0.8, alpha=0.5)\n",
    "    ax.set_ylim(lr_ylim)\n",
    "    ax.set_xlabel('Time (s)', fontsize=13)\n",
    "    ax.set_ylabel('Activity (dF/F)', fontsize=13)\n",
    "    ax.set_title(f'Right {region_name}', fontsize=14, fontweight='bold')\n",
    "    ax.legend(fontsize=11, loc='best')\n",
