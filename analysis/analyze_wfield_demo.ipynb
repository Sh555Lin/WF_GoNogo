    "    \n",
    "    lr_min = min(min(all_left_vals), min(all_right_vals))\n",
    "    lr_max = max(max(all_left_vals), max(all_right_vals))\n",
    "    lr_margin = (lr_max - lr_min) * 0.1\n",
    "    lr_ylim = [lr_min - lr_margin, lr_max + lr_margin]\n",
    "    \n",
    "    diff_min = min(all_diff_vals)\n",
    "    diff_max = max(all_diff_vals)\n",
    "    diff_margin = (diff_max - diff_min) * 0.1\n",
    "    diff_ylim = [diff_min - diff_margin, diff_max + diff_margin]\n",
    "    \n",
    "    # 左脑\n",
    "    ax = axes[0]\n",
    "    for tt in trial_types:\n",
    "        data = results[tt]\n",
