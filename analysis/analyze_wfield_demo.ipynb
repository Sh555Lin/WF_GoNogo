    "import numpy as np\n",
    "\n",
    "def svd_dff(U, V, mean_image):\n",
    "    \"\"\"\n",
    "    Vdf = svd_dff(U, V, mean_image)\n",
    "    (from cortexlab)\n",
    "    \n",
    "    Calculate delta F/F (dF/F) in SVD space\n",
    "    \"\"\"\n",
    "    \n",
    "    # Get the mean image in U-space (meanV)\n",
    "    nX, nY, nSVD = U.shape\n",
    "    flatU = U.reshape(nX * nY, nSVD)\n",
    "    meanV = flatU.T @ mean_image.flatten()\n",
    "    \n",
    "    # Define the baseline V as the reconstructed mean (meanV) + mean activity\n",
    "    V0 = meanV[:, np.newaxis] + np.mean(V, axis=1, keepdims=True)\n",
    "    \n",
    "    # Define the new V as the old V with a zero-mean\n",
    "    Vdf = V - np.mean(V, axis=1, keepdims=True)\n",
    "    \n",
    "    # Get (soft) dF/F in U-space by dividing U by average + soft\n",
    "    df_softnorm = np.median(mean_image) * 1\n",
    "    \n",
    "    # 安全检查：确保 df_softnorm 不会太小\n",
    "    if df_softnorm < 1.0:\n",
    "        print(f\"Warning: df_softnorm is very small ({df_softnorm}), setting to 1.0\")\n",
    "        df_softnorm = 1.0\n",
    "    \n",
    "    # 处理可能的零值或负值\n",
    "    mean_flat = mean_image.flatten()[:, np.newaxis]\n",
    "    denominator = mean_flat + df_softnorm\n",
    "    \n",
    "    # 确保没有零或负的分母\n",
    "    denominator = np.maximum(denominator, df_softnorm * 0.01)  # 至少是 df_softnorm 的 1%\n",
    "    \n",
    "    # 执行除法\n",
    "    nonnormU = flatU / denominator\n",
    "    \n",
    "    # 检查并处理 NaN/Inf\n",
    "    if np.any(~np.isfinite(nonnormU)):\n",
    "        n_bad = np.sum(~np.isfinite(nonnormU))\n",
    "        print(f\"Warning: Found {n_bad} non-finite values in nonnormU, replacing with 0\")\n",
    "        nonnormU = np.nan_to_num(nonnormU, nan=0.0, posinf=0.0, neginf=0.0)\n",
    "    \n",
    "    nonnormU = nonnormU.reshape(nX, nY, nSVD)\n",
    "    \n",
    "    # New df/f U's aren't orthonormal: change df/f V basis set into old U space\n",
    "    Vdf = change_U(nonnormU, Vdf, U)\n",
    "    \n",
    "    return Vdf\n",
    "\n",
    "\n",
    "def change_U(U, V, newU):\n",
    "    \"\"\"\n",
    "    new_V = change_U(U, V, newU)\n",
    "    \n",
    "    (adapted from cortexlab ChangeU)\n",
    "    Given SVD-compressed movie (U,V), changes the V's from the U basis set to\n",
    "    the newU basis set\n",
    "    \n",
    "    newV = newU' * U * V\n",
    "    \"\"\"\n",
    "    nSVD = U.shape[2]\n",
    "    new_nSVD = newU.shape[2]\n",
    "    \n",
    "    # Reshape U and newU to 2D: (nX*nY, nSVD)\n",
    "    flatU = U.reshape(-1, nSVD)\n",
    "    flatNewU = newU.reshape(-1, new_nSVD)\n",
    "    \n",
    "    # Handle NaN/Inf values before matrix multiplication\n",
    "    if np.any(~np.isfinite(flatNewU)):\n",
    "        print(\"Warning: newU contains non-finite values, replacing with 0\")\n",
    "        flatNewU = np.nan_to_num(flatNewU, nan=0.0, posinf=0.0, neginf=0.0)\n",
    "    \n",
    "    if np.any(~np.isfinite(flatU)):\n",
    "        print(\"Warning: U contains non-finite values, replacing with 0\")\n",
    "        flatU = np.nan_to_num(flatU, nan=0.0, posinf=0.0, neginf=0.0)\n",
    "    \n",
    "    # Compute: newV = newU' * U * V\n",
    "    new_V = flatNewU.T @ flatU @ V\n",
    "    \n",
    "    return new_V"
   ]
